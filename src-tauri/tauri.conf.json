{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "VoiceType",
  "identifier": "com.tmwgsicp.voicetype2",
  "version": "0.2.3",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd src-ui && npm run dev",
    "beforeBuildCommand": "cd src-ui && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VoiceType 配置",
        "url": "/",
        "width": 1000,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "decorations": true,
        "resizable": true
      },
      {
        "label": "floating",
        "title": "",
        "url": "/floating.html",
        "width": 320,
        "height": 52,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "x": 800,
        "y": 900
      },
      {
        "label": "edit-menu",
        "title": "",
        "url": "/edit-menu.html",
        "width": 212,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": false
      },
      {
        "label": "reply",
        "title": "地道回复",
        "url": "/reply.html",
        "width": 460,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "tmwgsicp",
    "homepage": "https://github.com/tmwgsicp/voicetype",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "dmg"],
    "resources": [
      "../dist/voicetype-server/**/*"
    ],
    "copyright": "Copyright © 2026 tmwgsicp. Licensed under AGPL-3.0.",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
